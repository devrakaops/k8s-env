#!/bin/bash

# 1. नेमस्पेस बनाना
kubectl create namespace priority

# 2. ResourceQuota लागू करना (ताकि केवल 200m CPU ही उपलब्ध हो)
kubectl apply -f - <<EOF
apiVersion: v1
kind: ResourceQuota
metadata:
  name: low-resource-quota
  namespace: priority
spec:
  hard:
    requests.cpu: "200m"
EOF

# 3. कम प्राथमिकता वाली पहली डिप्लॉयमेंट (जगह घेरने के लिए - 100m CPU)
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: low-priority-app-1
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: low-app-1
  template:
    metadata:
      labels:
        app: low-app-1
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          resources:
            requests:
              cpu: "100m"
EOF

# 4. कम प्राथमिकता वाली दूसरी डिप्लॉयमेंट (बची हुई जगह घेरने के लिए - 100m CPU)
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: low-priority-app-2
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: low-app-2
  template:
    metadata:
      labels:
        app: low-app-2
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          resources:
            requests:
              cpu: "100m"
EOF

# थोड़ी देर रुकें ताकि पहले दोनों पॉड्स रनिंग स्टेट में आ जाएं
sleep 5

# 5. मुख्य डिप्लॉयमेंट (busybox-logger) - यह रिसोर्स की कमी (0m CPU बचा है) के कारण Pending रह जाएगी
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: busybox-logger
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: logger
  template:
    metadata:
      labels:
        app: logger
    spec:
      containers:
        - name: logger
          image: busybox:stable
          command: ["sh", "-c", "while true; do echo 'logging'; sleep 1; done"]
          resources:
            requests:
              cpu: "100m" # इसके लिए अब क्लस्टर में जगह नहीं है!
EOF

sleep 10

echo ""
echo "========================================="
echo "Lab Setup Complete"
echo "========================================="

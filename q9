#!/bin/bash

# Color codes for terminal formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

kubectl delete namespace priority --ignore-not-found=true
kubectl delete priorityclass high-priority --ignore-not-found=true
sleep 2

kubectl create namespace priority

# These pods will occupy the node resources initially without any explicit priority class

# Deployment 1: Frontend App
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: low-priority-frontend
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          resources:
            requests:
              cpu: "250m"
              memory: "200Mi"
EOF

# Deployment 2: Backend App
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: low-priority-backend
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          resources:
            requests:
              cpu: "250m"
              memory: "200Mi"
EOF

# Deployment 3: Database Proxy App
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: low-priority-db-proxy
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: db-proxy
  template:
    metadata:
      labels:
        app: db-proxy
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          resources:
            requests:
              cpu: "250m"
              memory: "200Mi"
EOF

sleep 10
kubectl get pods -n priority

echo "----------------------------------------------------------------"
echo -e "${BLUE}=== STEP 4: Deploying the high-resource busybox-logger ===${NC}"
# Increased resource requests to 600m CPU and 450Mi Memory.
# Without a priorityClassName, this heavy pod will remain trapped in a Pending state.
kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: busybox-logger
  namespace: priority
spec:
  replicas: 1
  selector:
    matchLabels:
      app: logger
  template:
    metadata:
      labels:
        app: logger
    spec:
      containers:
        - name: logger
          image: busybox:stable
          command: ["sh", "-c", "while true; do echo 'logging'; sleep 1; done"]
          resources:
            requests:
              cpu: "600m"
              memory: "450Mi"
EOF

echo -e "${GREEN}=== High-resource lab environment setup complete! ===${NC}"

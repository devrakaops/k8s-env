#!/bin/bash

# ==========================================
# 1. Install MetalLB
# ==========================================
kubectl apply -f \
https://raw.githubusercontent.com/metallb/metallb/v0.13.12/config/manifests/metallb-native.yaml

echo "⏳ Waiting for MetalLB pods..."

kubectl wait -n metallb-system \
  --for=condition=ready pod \
  --all \
  --timeout=180s

# ==========================================
# 2. Configure MetalLB IP Pool
# ==========================================
NODE_IP=$(kubectl get node -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

BASE_IP=$(echo $NODE_IP | awk -F. '{print $1"."$2"."$3}')

START_IP="${BASE_IP}.200"
END_IP="${BASE_IP}.210"

echo "Using IP Range: ${START_IP}-${END_IP}"

cat <<EOF | kubectl apply -f -
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: my-ip-pool
  namespace: metallb-system
spec:
  addresses:
  - ${START_IP}-${END_IP}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: my-l2adv
  namespace: metallb-system
spec: {}
EOF

# ==========================================
# 3. Install NGINX Ingress Controller
# ==========================================
kubectl apply -f \
https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/cloud/deploy.yaml

echo "⏳ Waiting for ingress controller..."

kubectl rollout status deployment/ingress-nginx-controller \
-n ingress-nginx \
--timeout=300s

# ==========================================
# 4. Create Namespace + Deployment + Service
# ==========================================
kubectl apply -f - <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: sound-repeater
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: echoserver
  namespace: sound-repeater
spec:
  replicas: 1
  selector:
    matchLabels:
      app: echo
  template:
    metadata:
      labels:
        app: echo
    spec:
      containers:
      - name: echo
        image: registry.k8s.io/echoserver:1.10
        ports:
        - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: echoserver-service
  namespace: sound-repeater
spec:
  selector:
    app: echo
  ports:
  - port: 8080
    targetPort: 8080
EOF

# ==========================================
# 5. Wait For External IP
# ==========================================

while true; do
  EXTERNAL_IP=$(kubectl get svc ingress-nginx-controller \
  -n ingress-nginx \
  -o jsonpath='{.status.loadBalancer.ingress[0].ip}')

  if [ -n "$EXTERNAL_IP" ]; then
    break
  fi

  sleep 2
done


# ==========================================
# 6. Optional /etc/hosts Entry
# ==========================================
if command -v sudo >/dev/null 2>&1; then
  echo "$EXTERNAL_IP example.org" | sudo tee -a /etc/hosts >/dev/null
fi

echo ""
echo "✅ Environment Ready"

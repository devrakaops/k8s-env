#!/bin/bash

# Color codes for terminal formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== STEP 1: Cleaning up old lab components ===${NC}"
kubectl delete namespace mariadb --ignore-not-found=true
kubectl delete pv mariadb-pv --ignore-not-found=true
rm -f ~/mariadb-deployment.yaml

echo -e "${BLUE}=== STEP 2: Creating the 'mariadb' Namespace ===${NC}"
kubectl create namespace mariadb

echo -e "${BLUE}=== STEP 3: Creating the single existing PersistentVolume ===${NC}"
# Creating a PV with storageClassName: local-path
kubectl apply -f - <<EOF
apiVersion: v1
kind: PersistentVolume
metadata:
  name: mariadb-pv
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-path
  hostPath:
    path: "/mnt/data-mariadb"
EOF

echo -e "${BLUE}=== STEP 4: Creating the deployment manifest file at ~/mariadb-deployment.yaml ===${NC}"
# This manifest creates a basic MariaDB deployment WITHOUT any volume mounts configuration.
# You will need to edit this file to solve the task.
cat << 'EOF' > ~/mariadb-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mariadb
  namespace: mariadb
  labels:
    app: mariadb
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mariadb
  template:
    metadata:
      labels:
        app: mariadb
    spec:
      containers:
        - name: mariadb
          image: mariadb:10.6
          env:
            - name: MARIADB_ROOT_PASSWORD
              value: "password123"
          ports:
            - containerPort: 3306
              name: mysql
EOF

echo -e "${GREEN}=== Lab environment setup complete! ===${NC}"
echo -e "${GREEN}1. The 'mariadb-pv' has been created in the cluster.${NC}"
echo -e "${GREEN}2. The template file is ready at: ~/mariadb-deployment.yaml${NC}"
echo -e "${GREEN}3. Run 'kubectl get pv' to verify the storage status.${NC}"

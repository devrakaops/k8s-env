#!/bin/bash

# Color codes for terminal formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== STEP 1: Cleaning up old lab components ===${NC}"
kubectl delete namespace mariadb --ignore-not-found=true
kubectl delete pv mariadb-pv --ignore-not-found=true
rm -f ~/mariadb-deployment.yaml

echo -e "${BLUE}=== STEP 2: Creating the 'mariadb' Namespace ===${NC}"
kubectl create namespace mariadb

echo -e "${BLUE}=== STEP 3: Creating the single existing PersistentVolume ===${NC}"
# Pre-creating the PV that the PVC will bind to
kubectl apply -f - <<EOF
apiVersion: v1
kind: PersistentVolume
metadata:
  name: mariadb-pv
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-path
  hostPath:
    path: "/mnt/data-mariadb"
EOF

echo -e "${BLUE}=== STEP 4: Creating combined PVC and Deployment manifest ===${NC}"
# This writes both the complete PVC and the incomplete Deployment into a single file.
# The candidate only needs to fill in the PVC name under the volumes block.
cat << 'EOF' > ~/mariadb-deployment.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mariadb
  namespace: mariadb
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: 250Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mariadb
  namespace: mariadb
  labels:
    app: mariadb
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mariadb
  template:
    metadata:
      labels:
        app: mariadb
    spec:
      containers:
        - name: mariadb
          image: mariadb:10.6
          env:
            - name: MARIADB_ROOT_PASSWORD
              value: "password123"
          ports:
            - containerPort: 3306
              name: mysql
          volumeMounts:
            - name: mariadb-storage
              mountPath: /var/lib/mysql
      volumes:
        - name: mariadb-storage
          persistentVolumeClaim:
            claimName:  # <--- CANDIDATE NEEDS TO FILL THIS IN WITH: mariadb
EOF



echo "---------------------------------------------------------------------------"
echo " "
echo "--------------------- Exam Environment Ready for Q10-----------------------"
echo ""
echo "----------------------------------------------------------------------------"
